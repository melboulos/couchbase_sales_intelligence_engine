%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#2F5496', 'primaryTextColor': '#fff', 'primaryBorderColor': '#1F3864', 'lineColor': '#8a8f98', 'fontFamily': 'monospace', 'fontSize': '13px'}, 'flowchart': {'curve': 'basis', 'nodeSpacing': 45, 'rankSpacing': 60}}}%%

flowchart TD

    STAGE0["<b>0 · Universal Grounding Pre-Pass</b><br/>serper_enrichment_pass.py — run once, before everything else<br/>Real web search for every account, saved to one shared cache<br/>reused across any account list this pipeline processes"]

    START(["<b>main.py</b> starts"])

    CACHEMERGE["<b>1 · Load + Grounding Merge</b><br/>pipeline/loader.py :: load_accounts()<br/>Reads Stage 0's cache once, right here, before anything else runs"]

    subgraph STAGE2["2 · Classification — name first, search as fallback"]
        direction TB
        NORM["Normalization :: company_normalizer.py"]
        PASSA["<b>First attempt</b> — match account name<br/>industry_classifier.py + company_intelligence.py<br/>fast, reliable, blind to unrecognizable names"]
        PASSB["<b>Second attempt</b> — only if the first found nothing<br/>falls back to Stage 0's cached search text<br/>never overrides a real name-match"]
        NONPROFIT["Non-Profit / Charity gets its own explicit category<br/>rather than falling into generic 'unclassified'"]
        BIZMODEL["Business Model set alongside Industry<br/>drives category-specific AI-opportunity messaging"]
        TECH["Technology / Account Intelligence / Enrichment /<br/>Archetype / Scoring signals enriched"]

        NORM --> PASSA --> PASSB --> NONPROFIT --> BIZMODEL --> TECH
    end

    OWNERSHIP["<b>3 · Ownership / Rebrand Signal Detection</b><br/>modules/ownership_signal_detector.py<br/>Free, deterministic scan of Stage 0's cached text for<br/>phrases like 'is now', 'acquired by', 'rebrand'<br/>No AI, no new search — pure text matching"]

    subgraph STAGE4["4 · Scoring, Explanation, Gate"]
        direction TB
        SCORE["scoring_engine.py :: calculate_coi()<br/>Workload Fit + Database Opportunity + Real-Time +<br/>Technical Environment + Company Context"]
        EXPL["opportunity_explainer.py"]
        GATE["deterministic_gate.py<br/>real workload signal AND score above threshold → qualifies"]
        SCORE --> EXPL --> GATE
    end

    DECISION{"qualifies?"}
    SKIP(["Skip — no further cost"])

    subgraph STAGE5["5 · AI-Generated Sales Intelligence"]
        direction TB
        NOTE["Stage 1's cache and this stage's search are two<br/>SEPARATE calls: one cached/free/classification-only,<br/>one live/per-account/feeds the actual AI prompt"]
        REGATE["Gate re-checked at the individual account level"]
        LOCATION["Account location read — disambiguates common<br/>company names in the search that follows"]
        LIVESEARCH["Live search for this specific account<br/>includes automatic retry on rate-limit/timeout"]
        PROMPT["Prompt built from account data + fresh search result<br/>bans naming Couchbase/database in one specific field<br/>independent score computed blind to the deterministic one"]
        CALL["Bedrock call — meta.llama3-70b-instruct-v1:0"]
        VALIDATE["~15 validation checks before trusting the response:<br/>genuine company recognition · evidence-backed scoring ·<br/>realistic scale · still operating · not hallucinated"]

        NOTE --- REGATE --> LOCATION --> LIVESEARCH --> PROMPT --> CALL --> VALIDATE
    end

    MERGE["<b>6 · Merge &amp; Export</b><br/>Only validated accounts merge back, matched by account name<br/>End-of-run summary reports real search-grounding coverage"]

    EXPORT["intelligence_export_pipeline.py → Streamlit JSON"]
    EXCEL["build_ae_call_list.py → AE_Call_List.xlsx<br/>🔍 Web-Verified · ⚠ Not Company-Verified ·<br/>🏢 Possible Ownership Change"]

    STAGE0 -.->|builds the shared cache| CACHEMERGE
    START --> CACHEMERGE --> STAGE2
    STAGE2 --> OWNERSHIP --> STAGE4
    GATE --> DECISION
    DECISION -- No --> SKIP
    DECISION -- Yes --> STAGE5
    VALIDATE --> MERGE
    SKIP --> MERGE
    MERGE --> EXPORT
    MERGE --> EXCEL

    classDef decision fill:#1F3864,stroke:#1F3864,color:#fff
    classDef terminal fill:#2F5496,stroke:#1F3864,color:#fff
    classDef plain fill:#fff,stroke:#E2E5EA,color:#1a1a1a,text-align:left

    class DECISION decision
    class START,SKIP terminal
    class STAGE0,CACHEMERGE,NORM,PASSA,PASSB,NONPROFIT,BIZMODEL,TECH,OWNERSHIP,SCORE,EXPL,GATE,NOTE,REGATE,LOCATION,LIVESEARCH,PROMPT,CALL,VALIDATE,MERGE,EXPORT,EXCEL plain
